APP_NAME="Power GPI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local simple setup. Pour production, utiliser PostgreSQL/MySQL.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=gpi
# DB_USERNAME=gpi
# DB_PASSWORD=

# Frontend origin(s) allowed by CORS — comma separated.
FRONTEND_URL=http://localhost:5173,https://gpi-umber.vercel.app

# Seeded administrator account.
ADMIN_EMAIL=admin@gpi.local
ADMIN_PASSWORD=Gpi@2026
ADMIN_NOM=Admin
ADMIN_PRENOM=GPI

# Assistance chatbot. driver=rule (offline), openai (OpenAI-compatible API) or anthropic (Claude).
# Sans clé API (CHATBOT_API_KEY ou CHATBOT_ANTHROPIC_API_KEY vide), retombe
# automatiquement sur le moteur "rule" hors-ligne. Coller une clé suffit donc
# à activer l'IA, sans autre changement.
#
# Groq (https://console.groq.com) est gratuit, sans carte bancaire, et
# compatible OpenAI — c'est le driver "openai" pointé sur son API.
CHATBOT_DRIVER=openai
CHATBOT_BASE_URL=https://api.groq.com/openai/v1
CHATBOT_API_KEY=
CHATBOT_MODEL=openai/gpt-oss-120b

# Driver "anthropic" (Claude) : nécessite une clé API Anthropic (console.anthropic.com).
CHATBOT_ANTHROPIC_API_KEY=
CHATBOT_ANTHROPIC_MODEL=claude-sonnet-4-5
CHATBOT_ANTHROPIC_MAX_TOKENS=1024

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gpi.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
